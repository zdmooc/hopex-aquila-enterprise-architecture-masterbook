<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MayaBank_KYC_Soluxan" targetNamespace="https://mayabank.example/reference/soluxan">
  <bpmn:process id="Process_MayaBank_Onboarding" name="MayaBank — Entrée en relation Customer/KYC (référence)" isExecutable="false">
    <bpmn:documentation>REFERENCE_ARCHITECTURE MayaBank / synthetic business process; NOT_CLIENT_APPROVED, NOT_RUNTIME_EXECUTED. Timeouts core are UNKNOWN until inquiry; never retry Customer creation blindly. Selfcare, Customer360 projection and production integration are outside the scope of this process.</bpmn:documentation>
    <bpmn:startEvent id="Start_Prospect" name="Demande prospect"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Capture" name="Saisir le prospect"><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Identity" name="Vérifier identité"><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Identity" name="Identité vérifiée ?"><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing><bpmn:outgoing>F05</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Profile" name="Compléter CDD / KYB"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Screening" name="Screening contrôlé"><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Screening" name="Résultat screening ?"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Approve" name="Décision KYC APPROVED"><bpmn:incoming>F09</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Consent" name="Tracer consentements"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CreateCustomer" name="Créer Customer (clé stable)"><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Core" name="Réponse core ?"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Created" name="Customer confirmé"><bpmn:incoming>F18</bpmn:incoming><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_Inquiry" name="Inquiry / réconciliation"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Inquiry" name="Résultat inquiry ?"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Repair" name="Case d&apos;exception (sans retry aveugle)"><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Pending" name="En attente / exception"><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F23</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_RequestInfo" name="Demander compléments"><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ManualReview" name="Revue humaine habilitée"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Review" name="Décision reviewer ?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="KYC rejeté"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Prospect" targetRef="Task_Capture" name="start" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Capture" targetRef="Task_Identity" name="prospect enregistré" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Identity" targetRef="Gateway_Identity" name="vérification" />
    <bpmn:sequenceFlow id="F04" sourceRef="Gateway_Identity" targetRef="Task_Profile" name="VERIFIED" />
    <bpmn:sequenceFlow id="F05" sourceRef="Gateway_Identity" targetRef="Task_RequestInfo" name="UNRESOLVED" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_RequestInfo" targetRef="End_Pending" name="attente preuve" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Profile" targetRef="Task_Screening" name="profil complet" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_Screening" targetRef="Gateway_Screening" name="résultat" />
    <bpmn:sequenceFlow id="F09" sourceRef="Gateway_Screening" targetRef="Task_Approve" name="CLEAR" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gateway_Screening" targetRef="Task_ManualReview" name="REVIEW" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_ManualReview" targetRef="Gateway_Review" name="proposition décision" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gateway_Review" targetRef="Task_Approve" name="APPROVED" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gateway_Review" targetRef="Task_RequestInfo" name="MORE_INFORMATION" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gateway_Review" targetRef="End_Rejected" name="REJECTED" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Approve" targetRef="Task_Consent" name="KYC approuvé" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Consent" targetRef="Task_CreateCustomer" name="consentement tracé" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_CreateCustomer" targetRef="Gateway_Core" name="creation intent" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gateway_Core" targetRef="End_Created" name="ACK_CONFIRMED" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gateway_Core" targetRef="Task_Inquiry" name="TIMEOUT_UNKNOWN" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Inquiry" targetRef="Gateway_Inquiry" name="statut interrogé" />
    <bpmn:sequenceFlow id="F21" sourceRef="Gateway_Inquiry" targetRef="End_Created" name="CREATED_CONFIRMED" />
    <bpmn:sequenceFlow id="F22" sourceRef="Gateway_Inquiry" targetRef="Task_Repair" name="UNKNOWN_AFTER_INQUIRY" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Repair" targetRef="End_Pending" name="reprise pilotée" />
  </bpmn:process>
